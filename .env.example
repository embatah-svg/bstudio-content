# B.Studio — credenziali per l'auto-publish su Instagram.
# 1) Compila i 3 valori qui sotto  2) salva questo file come ".env" (togli .example)
# ⚠️ NON committare il .env: contiene un token segreto.

# ID dell'account Instagram Business (lo ottieni dal Graph API Explorer — vedi guida)
IG_USER_ID=

# Token long-lived (dura ~60 giorni, poi va rinnovato)
ACCESS_TOKEN=

# URL pubblico base dove sono ospitati gli asset (_export PNG + out MP4).
# Esempio GitHub raw:
# ASSET_BASE_URL=https://raw.githubusercontent.com/TUO-UTENTE/TUO-REPO/main/bstudio-content-30days
ASSET_BASE_URL=
